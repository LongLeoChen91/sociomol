# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Environments
.env
.venv
env/
venv/

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Whitelist demo data in examples/ (these are committed intentionally)
!examples/**/*.star
!examples/**/*.csv
!examples/**/*.sh

# Generated outputs (produced when users run examples or predictions)
# Placed after whitelist to ensure outputs are ignored even in examples/
*_annotated.star
*_arms.star
*_edges.csv
H1_DoubleLinker.star
Avg_Linkers.star
Linker_edges.csv
DoubleLinker_edges.csv
split_by_tomo/

# Helper files
CLAUDE.md
# Always allow GroundTruth files
!*GroundTruth*.csv
# Private experimental datasets
New_examples/
Local_analysis/
Evaluation4Local_analysis/
# AI Agent config
.antigravityrules

# Cryo-EM / Tomography volume files
*.mrc

# Generated cylinder output directories
cylinders_out_solid/
cylinders_out/

# Ignore postprocess outputs completely (overriding the examples whitelist)
postprocess_output/
examples/**/postprocess_output/**/*.star
examples/**/postprocess_output/**/*.csv
examples/**/postprocess_output/**/*.png
